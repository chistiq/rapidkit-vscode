!node_modules/*/README.md

# Exclude webview-ui source (only need dist/webview.js and dist/webview.css)
webview-ui/**

# Exclude build/test documentation (not needed in VSIX)
BUILD_SUMMARY.md
READY_TO_TEST.md
RELEASE_NOTES_v*.md

# Exclude test files
**/*.test.js
**/*.spec.js
**/test/**
**/tests/**

# Exclude dev files
.eslintrc.js
.prettierrc
pyrightconfig.json
pytest.ini
jest.config.*
vitest.config.*
esbuild.js

# Exclude git files
.git/**
.github/**
.gitattributes

# Exclude development/testing artifacts
.husky/**
coverage/**
artifacts/**
test-results/**
releases/**
scripts/**

# Exclude documentation (available online)
docs/**

# Keep local configuration, private material, and development assets out of releases.
media/README.md
media/screenshots/archive/**
CONTRIBUTING.md
review-artifacts/**

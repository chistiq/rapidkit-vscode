{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@workspai-contracts/*": ["../src/contracts/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
